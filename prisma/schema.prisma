generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  username      String   @unique
  email         String?  @unique
  phone         String   @unique
  passwordHash  String
  referralCode  String   @unique @default(cuid())
  isActive      Boolean  @default(true)
  isMember      Boolean  @default(false)
  roleId        String? 
  role          Role?    @relation(fields: [roleId], references: [id])
  memberships   Membership[]
  submissions   TaskSubmission[]
  transactions  Transaction[]
  referralsSent Referral[] @relation("Referrer")
  referralsRec  Referral[] @relation("Referred")
  withdrawals   Withdrawal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model Membership {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  amount           Int
  currency         String  @default("RWF")
  paymentProvider  String?
  paymentReference String?  @unique
  status           String   @default("pending")
  attachmentUrl    String?
  submittedAt      DateTime @default(now())
  reviewedAt       DateTime?
  adminId          String?
}

model Task {
  id                String   @id @default(cuid())
  title             String
  description       String
  submissionType    String
  rewardAmount      Int
  startAt           DateTime
  endAt             DateTime
  submissionDeadline DateTime?
  dailyMaxPerUser   Int     @default(200)
  createdBy         String?
  createdAt         DateTime @default(now())
  submissions       TaskSubmission[]
}

model Media {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  originalName String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  durationSecs Int?
  mediaType    String
  uploadedAt   DateTime @default(now())
  expiresAt    DateTime?
  isDeleted    Boolean  @default(false)
}

model TaskSubmission {
  id                 String   @id @default(cuid())
  task               Task     @relation(fields: [taskId], references: [id])
  taskId             String
  user               User     @relation(fields: [userId], references: [id])
  userId             String
  media              Media?   @relation(fields: [mediaId], references: [id])
  mediaId            String?
  status             String   @default("pending")
  rewardAmountAwarded Int? 
  submittedAt        DateTime @default(now())
  reviewedAt         DateTime?
  reviewerId         String?
  notes              String?
}

model Referral {
  id              String   @id @default(cuid())
  referrer        User     @relation("Referrer", fields: [referrerId], references: [id])
  referrerId      String
  referred        User?    @relation("Referred", fields: [referredId], references: [id])
  referredId      String?
  code            String
  status          String   @default("registered")
  createdAt       DateTime @default(now())
  qualifiedAt     DateTime?
  rewardedAt      DateTime?
  rewardTxId      String?
}

model Transaction {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  type       String
  category   String
  amount     Int
  currency   String @default("RWF")
  reference  String @unique
  status     String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model Withdrawal {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  amount         Int
  method         String
  recipientDetails Json
  status         String   @default("pending")
  adminId        String?
  transactionRef String?
  requestedAt    DateTime @default(now())
  processedAt    DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  channel   String
  to        String
  template  String
  payload   Json?
  status    String
  sentAt    DateTime?
}

model SupportTicket {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  category    String
  subject     String
  description String
  attachment  String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}
